# Copy this to $HOME/data/goetta-finance/.env on the server (NOT into the
# repo — that .env is read by docker-compose.yml's env_file: and never
# committed; goals of the placement: it lives next to data.duckdb, and
# git-pushing new code never touches it).

# IANA timezone name. Controls the daemon's daily --sync-at local time and
# every locally-displayed timestamp (dashboard, CLI). Unset defaults to UTC
# inside the container, which is rarely what you want.
TZ=America/New_York
